APP_ENV=dev
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
LOG_LEVEL=info
PROXY_BACKEND_URL=http://127.0.0.1:3000
IP_ACCESS_CONFIG=config/ip_rules.yaml
IP_DEFAULT_DENY=true
IP_CACHE_CAPACITY=4096
IP_CACHE_TTL=1m
IP_CAPTCHA_TTL=10m
CACHE_DEFAULT_TTL=5m
CACHE_MAX_BODY=1048576
RATE_LIMIT_RPS=100
RATE_LIMIT_RPM=1000
RATE_LIMIT_MAX_CONN=500
RATE_LIMIT_BAN_SEC=3600
